+void AckmanHostStateLoadBegin(void) {
+  SetAudioPaused(true);
+#if SNESRECOMP_SDL3
+  /* Callback owns stream -> APU mutex. Take the same order and keep the
+   * stream locked across the entire restore, including failure rollback. */
+  if (g_audio_stream) SDL_LockAudioStream(g_audio_stream);
+  if (g_audio_stream_buffer)
+    memset(g_audio_stream_buffer, 0, g_audio_stream_buffer_size);
+#else
+  if (g_audio_device) SDL_LockAudioDevice(g_audio_device);
+#endif
+  ResetAudioTimeline();
+  RtlApuLock();
+  RtlAudioResetTimeline();
+  RtlApuUnlock();
+}
+void AckmanHostStateLoadEnd(void) {
+  /* Loaded saves can bring their old output ring back. Discard it only after
+   * all guest channels/ports/clocks and Ackman music routing are reconciled. */
+  ResetAudioTimeline();
+  RtlApuLock();
+  RtlAudioResetTimeline();
+  RtlApuUnlock();
+#if SNESRECOMP_SDL3
+  if (g_audio_stream) SDL_UnlockAudioStream(g_audio_stream);
+#else
+  if (g_audio_device) SDL_UnlockAudioDevice(g_audio_device);
+#endif
+  g_dialog_audio_dirty=true;
+  snesrecomp_desktop_request_clock_reset();
+  host_report_breadcrumb("state audio flushed: host buffers, DSP output ring and resampler reset");
+}
 void AckmanHostDialogPause(void) {
