+extern "C" int snes_mod_runtime_select_package_c(const char *id,const char *version,int enabled) {
+    auto &runtime=SNESRecomp::state();
+    if(!runtime.initialized)return 0;
+    auto previous=runtime.selections;
+    if(!id) {
+        runtime.selections.clear();
+        for(const auto &entry:runtime.packages)for(const auto &v:entry.second) {
+            auto &selection=SNESRecomp::package_selection(runtime,v.second);
+            for(const auto &feature:v.second.features) {
+                auto &f=selection.features[feature.id];f.enabled=false;f.has_enabled=true;
+            }
+        }
+    } else {
+        auto package=runtime.packages.find(id);
+        if(package==runtime.packages.end())return 0;
+        auto v=package->second.find(version?version:"");
+        if(v==package->second.end())return 0;
+        auto &selection=SNESRecomp::package_selection(runtime,v->second);
+        selection.version=v->second.version;
+        for(const auto &feature:v->second.features) {
+            auto &f=selection.features[feature.id];f.enabled=enabled!=0;f.has_enabled=true;
+        }
+    }
+    runtime.validation=SNESRecomp::validate(runtime);
+    if(!runtime.validation.ok) {
+        runtime.selections=std::move(previous);
+        runtime.validation=SNESRecomp::validate(runtime);
+        runtime.error="Package cannot be activated by this build.";return 0;
+    }
+    runtime.error.clear();return 1;
+}
