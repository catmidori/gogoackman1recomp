+    g_config.fullscreen=(SDL_GetWindowFlags(g_window)&SDL_WINDOW_FULLSCREEN)!=0;
+    g_win_flags=SDL_GetWindowFlags(g_window);
+  }
+  if(changes&ACK_SETTINGS_OUTPUT) {
+    int old=g_ackman_output_method;
+    SdlRenderer_Destroy();
+    if(!SdlRenderer_Init(g_window)) {
+      fprintf(stderr,"[menu] Output change failed; restoring previous driver\n");
+      g_config.output_method=(uint8)old;
+      if(!SdlRenderer_Init(g_window))Die("Unable to restore renderer");
+    }
+    if(g_ackman_last_w && g_ackman_last_pixels) {
